# Copy to .env for local runs (npm run dev). In Azure, set these as App Service
# application settings, and keep secrets in Key Vault references.

# --- Local trial without Microsoft 365 or Claude (in-memory, nothing is saved) ---
DEV_MOCK=false

# --- App ---
BASE_URL=https://ai-adoption-survey.azurewebsites.net
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=production

# --- Microsoft Entra ID app registration ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=
ADMIN_APP_ROLE=Survey.Admin
REVIEWER_APP_ROLE=Survey.Reviewer

# --- Shared Excel file (get both values with: npm run resolve-file -- "<sharing link>") ---
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
# Optional: use a local .xlsx instead of Graph (works with DEV_MOCK).
# Creates/uses Responses and Evidence sheets; keep the file closed while collecting responses.
EXCEL_LOCAL_PATH=

# --- Email through Microsoft Graph ---
MAIL_SENDER=ai-adoption-survey@example.org
ENABLE_RESULTS_EMAIL=true
# Mail transport override: "outlook" (local Outlook desktop, Windows), "console" (log only).
# Unset = Graph in production, console in DEV_MOCK.
MAIL_METHOD=
# Optional SMTP transport (used before outlook/console when SMTP_HOST is set)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Claude API (evidence follow-ups) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Survey rules ---
CYCLE_NAME=Baseline 2026
ALLOW_RESUBMIT=false
ALLOWED_EMAIL_DOMAINS=example.org
REQUIRE_EMAIL_CODE=true
LEVEL_THRESHOLD=0.6
MET_SCORE=3
