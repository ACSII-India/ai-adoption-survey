{
  "name": "ai-adoption-survey",
  "version": "1.0.0",
  "private": true,
  "description": "AI adoption self-assessment survey with evidence capture, Excel (OneDrive/SharePoint) storage, and admin and reviewer access",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --env-file=.env src/server.js",
    "setup-workbook": "node --env-file=.env scripts/setup-workbook.js",
    "resolve-file": "node --env-file=.env scripts/resolve-file.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "5.3.0",
    "express-rate-limit": "8.7.3",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "nodemailer": "^10.6.0"
  }
}
